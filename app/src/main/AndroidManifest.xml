<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      برنامه کامل آفلاین است: هیچ دسترسی اینترنت درخواست نمی‌کند و هیچ اجازه‌ای
      جز آنچه سرویس دسترس‌پذیریِ خودش لازم دارد نمی‌گیرد. این برنامه هیچ اعلانی
      نمی‌سازد، پس اجازهٔ اعلان هم نمی‌خواهد.
    -->

    <!-- اجازهٔ «نمایش روی برنامه‌های دیگر»: راهِ دومِ نمایشِ تاریخ، بی دسترس‌پذیری.
         این برنامه هیچ اعلانی نمی‌سازد. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gahshomar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- تاریخ روی نوار وضعیت و صفحهٔ قفل، بی هیچ اعلانی -->
        <service
            android:name=".notify.LockDateOverlay"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_lockdate" />
        </service>

        <!-- راهِ دوم: پنجرهٔ «روی برنامه‌ها»، بی نیاز به سرویس دسترس‌پذیری -->
        <service
            android:name=".notify.OverlayService"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- هر پانزده دقیقه پنجرهٔ تاریخ را برمی‌خیزاند و ویجت را تازه می‌کند -->
        <service
            android:name=".notify.OverlayKeepAliveJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
          صفحهٔ همیشه‌روشن (AOD) را سامانه می‌کشد و برنامه‌ها نمی‌توانند روی آن بنویسند.
          نزدیک‌ترین راه، محافظ صفحهٔ اندروید است: تاریخ با حروفِ درشت بر زمینهٔ سیاه.
        -->
        <service
            android:name=".notify.DateDreamService"
            android:exported="true"
            android:label="@string/dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/date_dream" />
        </service>

    </application>
</manifest>
