<?xml version="1.0" encoding="utf-8"?>
<!-- ویجتِ صفحهٔ اصلی: تاریخِ درشت، بی هیچ دسترسی ویژه‌ای -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_day"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:textColor="#FFF3D9"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="دی به آذر ۹ آبان" />

    <TextView
        android:id="@+id/widget_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#F2A659"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/vazirmatn_bold"
        android:text="۲۵۸۵" />
</LinearLayout>
