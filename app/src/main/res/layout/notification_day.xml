<?xml version="1.0" encoding="utf-8"?>
<!-- نوارگاه‌شمار: روز و ماه ایرانی و جشن‌های امروز، برای نوار وضعیت و صفحهٔ قفل -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textSize="34sp"
            android:textColor="#F0CE7E"
            android:includeFontPadding="false"
            android:text="۱۳" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/notif_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="17sp"
                    android:textColor="#F6EFE0"
                    android:text="آبان" />

                <TextView
                    android:id="@+id/notif_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="13sp"
                    android:textColor="#CBC3B2"
                    android:text="۱۴۰۵" />
            </LinearLayout>

            <TextView
                android:id="@+id/notif_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="#B9B2A3"
                android:text="پنجشنبه" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#33F0CE7E" />

    <TextView
        android:id="@+id/notif_ritual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12.5sp"
        android:textColor="#57D6C7"
        android:text="روز تیر از آبان ماه" />

    <TextView
        android:id="@+id/notif_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textSize="10.5sp"
        android:textColor="#B9B2A3"
        android:text="ستارهٔ باران" />

    <TextView
        android:id="@+id/notif_events"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:textSize="12.5sp"
        android:textColor="#F6EFE0"
        android:text="مهرگان — جشن" />

    <TextView
        android:id="@+id/notif_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:textSize="9.5sp"
        android:textColor="#8C8676"
        android:text="گاه‌شمار ایرانی" />
</LinearLayout>
